<StackPanel x:Class="UiAtlas.Presentation.AppearanceSettingsPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            UseLayoutRounding="True" TextElement.Foreground="{DynamicResource InkBrush}">
    <StackPanel.Resources>
        <Style x:Key="ChoiceList" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4.5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Rectangle Margin="3" RadiusX="4" RadiusY="4" StrokeDashArray="2 2"
                                               Stroke="{DynamicResource InkBrush}" StrokeThickness="1"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionInkBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThemeChoice" TargetType="ListBoxItem" BasedOn="{StaticResource Choice}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="ToolTip" Value="{Binding Description}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeChoice" TargetType="ListBoxItem" BasedOn="{StaticResource Choice}">
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionInkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <DockPanel Margin="0,0,0,14">
        <Border x:Name="PaletteIconHost" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource SoftBrush}" VerticalAlignment="Top" Margin="0,0,10,0"/>
        <StackPanel>
            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a palette and color mode." TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource MutedInkBrush}" Margin="0,3,0,0"/>
        </StackPanel>
    </DockPanel>
    <ListBox x:Name="ThemeList" Margin="-4.5,0" AutomationProperties.Name="Theme" Style="{StaticResource ChoiceList}"
             ItemContainerStyle="{StaticResource ThemeChoice}" SelectedValuePath="Id">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="3" SizeChanged="ThemeGrid_SizeChanged"/>
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <StackPanel>
                    <Border Height="46" Background="#FAFBF9" BorderBrush="{Binding Line}" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16*"/><ColumnDefinition Width="84*"/></Grid.ColumnDefinitions>
                            <Border Background="{Binding Sidebar}" BorderBrush="{Binding Line}" BorderThickness="0,0,1,0" CornerRadius="2,0,0,2"/>
                            <Grid Grid.Column="1" Margin="6,7" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48*"/><ColumnDefinition Width="18*"/><ColumnDefinition Width="21*"/><ColumnDefinition Width="13*"/>
                                </Grid.ColumnDefinitions>
                                <Border Height="5" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Accent}"/>
                                <Border Grid.ColumnSpan="3" Height="4" Margin="0,9,0,0" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Line}"/>
                                <Border Grid.ColumnSpan="2" Height="4" Margin="0,17,0,0" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Line}"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,5,0,0">
                        <Grid DockPanel.Dock="Right" Width="14" Height="14" Margin="5,0,0,0">
                            <Ellipse Stroke="{DynamicResource MutedInkBrush}"/>
                            <Path Data="M3.5,7 L6,9.5 L10.5,4.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4">
                                <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers></Style></Path.Style>
                            </Path>
                        </Grid>
                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                    </DockPanel>
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
    <ListBox x:Name="ModeList" AutomationProperties.Name="Color mode" Style="{StaticResource ChoiceList}"
             ItemContainerStyle="{StaticResource ModeChoice}" SelectedValuePath="Tag" Margin="-4.5,7,0,-4.5">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBoxItem Tag="light" AutomationProperties.Name="Light">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="Light" VerticalAlignment="Center"/>
            </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="dark" AutomationProperties.Name="Dark">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="Dark" VerticalAlignment="Center"/>
            </StackPanel>
        </ListBoxItem>
    </ListBox>
    <TextBlock x:Name="SaveError" Foreground="{DynamicResource ErrorBrush}" Margin="6,0,6,10"
               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
</StackPanel>
