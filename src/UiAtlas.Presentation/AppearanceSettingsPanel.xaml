<StackPanel x:Class="UiAtlas.Presentation.AppearanceSettingsPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            UseLayoutRounding="True" TextElement.Foreground="{DynamicResource InkBrush}">
    <StackPanel.Resources>
        <Style x:Key="ChoiceList" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Rectangle Margin="3" RadiusX="4" RadiusY="4" StrokeDashArray="2 2"
                                               Stroke="{DynamicResource InkBrush}" StrokeThickness="1"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border Margin="-4" BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource PanelCornerRadius}"/>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionInkBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThemeChoice" TargetType="ListBoxItem" BasedOn="{StaticResource Choice}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeChoice" TargetType="ListBoxItem" BasedOn="{StaticResource Choice}">
            <Setter Property="Padding" Value="18,12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionInkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Text="Appearance" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="24" Margin="6,0"/>
    <TextBlock Text="Choose a theme for every workspace, dialog and floating control." TextWrapping="Wrap"
               Foreground="{DynamicResource MutedInkBrush}" Margin="6,6,6,12"/>
    <ListBox x:Name="ThemeList" AutomationProperties.Name="Theme" Style="{StaticResource ChoiceList}"
             ItemContainerStyle="{StaticResource ThemeChoice}" SelectedValuePath="Id">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="3" SizeChanged="ThemeGrid_SizeChanged"/>
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <StackPanel>
                    <Border Height="76" Background="{Binding Surface}" BorderBrush="#44777777" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="4,4,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="{Binding TitleStart}"/>
                                        <GradientStop Offset="1" Color="{Binding TitleEnd}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding Sidebar}" CornerRadius="0,0,0,4"/>
                                <Grid Grid.Column="1" Margin="7,8,8,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*"/>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="3" Height="4" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Line}"/>
                                    <Border Grid.ColumnSpan="2" Height="4" Margin="0,10,0,0" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Line}"/>
                                    <Border Height="10" Margin="0,24,0,0" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Accent}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium" Margin="3,9,3,3"/>
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="{Binding SelectedItem.Description, ElementName=ThemeList}" AutomationProperties.LiveSetting="Polite"
               Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" FontSize="13" Margin="6,12,6,18"/>
    <TextBlock Text="Color mode" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="20" Margin="6,0"/>
    <ListBox x:Name="ModeList" AutomationProperties.Name="Color mode" Style="{StaticResource ChoiceList}"
             ItemContainerStyle="{StaticResource ModeChoice}" SelectedValuePath="Tag" Margin="0,6,0,10">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBoxItem Tag="light" AutomationProperties.Name="Light">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="Light" VerticalAlignment="Center"/>
            </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="dark" AutomationProperties.Name="Dark">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="Dark" VerticalAlignment="Center"/>
            </StackPanel>
        </ListBoxItem>
    </ListBox>
    <TextBlock x:Name="SaveError" Foreground="{DynamicResource ErrorBrush}" Margin="6,0,6,10"
               TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
</StackPanel>
