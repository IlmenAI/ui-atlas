<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType><UseWPF>true</UseWPF>
    <AssemblyName>UiAtlas</AssemblyName><RootNamespace>UiAtlas.Launcher</RootNamespace>
    <Product>UI Atlas</Product><ApplicationTitle>UI Atlas</ApplicationTitle>
    <ApplicationManifest>../UiAtlas.Core.Cli/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UiAtlas.Shell/UiAtlas.Shell.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Mapping.Atlas/UiAtlas.Core.Mapping.Atlas.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Recording.Windows/UiAtlas.Core.Recording.Windows.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Cli/UiAtlas.Core.Cli.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="UiAtlas.Shell.Tests" /></ItemGroup>
  <Target Name="StageAtlasLauncherTools" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../UiAtlas.Core.Cli/UiAtlas.Core.Cli.csproj" Targets="GetAtlasDeploymentFiles" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_LauncherTools" />
    </MSBuild>
    <Copy SourceFiles="@(_LauncherTools)" DestinationFiles="@(_LauncherTools->'$(TargetDir)tools/%(AtlasRelativePath)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishAtlasLauncherTools" AfterTargets="Publish" DependsOnTargets="StageAtlasLauncherTools">
    <Copy SourceFiles="@(_LauncherTools)" DestinationFiles="@(_LauncherTools->'$(PublishDir)tools/%(AtlasRelativePath)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
