<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="15,0" />
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ApplicationRowStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="20,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SoftBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SoftBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource SoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="Draft">
                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Archived">
                    <Setter Property="Background" Value="{DynamicResource SoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="Draft"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Archived"><Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LibraryTabStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="112"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SoftBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource PanelBrush}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
