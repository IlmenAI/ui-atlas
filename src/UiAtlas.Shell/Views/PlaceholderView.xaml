<UserControl x:Class="UIMaps.Application.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource CardStyle}" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="24">
                <TextBlock x:Name="GlyphText" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="HeadingText" Margin="0,18,0,0" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="15" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
