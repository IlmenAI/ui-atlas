<UserControl x:Class="UIMaps.Application.Views.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Recorded UI Maps library">
    <UserControl.Resources>
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="15,0" />
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ApplicationRowStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="20,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F7F9FC" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EEF3F9" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#E5F4E9" />
            <Setter Property="BorderBrush" Value="#C5E6CD" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="Draft">
                    <Setter Property="Background" Value="#FFF4DE" />
                    <Setter Property="BorderBrush" Value="#F0D8A8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Archived">
                    <Setter Property="Background" Value="#F0F2F5" />
                    <Setter Property="BorderBrush" Value="#D9DEE6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#187A39" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="Draft"><Setter Property="Foreground" Value="#9A5A00" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Archived"><Setter Property="Foreground" Value="#596579" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LibraryTabStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="112"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#F5F8FC"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="#F4F8FF"/><Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="ApplicationContextMenu" x:Shared="False">
            <MenuItem Header="Open application" Click="ContextOpenApplication_Click" />
            <MenuItem Header="Record new map" Tag="RecordNewMap" Click="ContextRecordNewMap_Click"
                      ToolTipService.ShowOnDisabled="True" />
            <Separator />
            <MenuItem Header="Archive application" Tag="ArchiveApplication" Foreground="#9A5A00" Click="ContextArchiveApplication_Click" />
            <MenuItem Header="Restore application" Tag="RestoreApplication" Foreground="{StaticResource AccentBrush}" Click="ContextRestoreApplication_Click" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="ApplicationsPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Maps" FontSize="38" FontWeight="Light" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Margin="0,9,0,0" Text="UI Maps, organized by application." FontSize="15.5" Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" MinWidth="165" Style="{StaticResource PrimaryActionButtonStyle}"
                                Click="NewMap_Click" AutomationProperties.Name="Record UI Map">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81E;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,9,0" />
                                <TextBlock Text="Record UI Map" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,28,0,0">
                        <RadioButton x:Name="ApplicationsActiveTab" GroupName="ApplicationArchiveScope" Content="Active" IsChecked="True" Style="{StaticResource LibraryTabStyle}" Click="ApplicationsActiveTab_Click"/>
                        <RadioButton x:Name="ApplicationsArchiveTab" GroupName="ApplicationArchiveScope" Content="Archive" Style="{StaticResource LibraryTabStyle}" Click="ApplicationsArchiveTab_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,30,0,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Applications" FontSize="18" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="13,0,0,0" VerticalAlignment="Center" Panel.ZIndex="1" IsHitTestVisible="False" />
                            <TextBox Height="42" Padding="39,10,12,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Search applications" ToolTip="Search applications" />
                        </Grid>
                        <ComboBox Grid.Column="2" Height="42" Padding="10,6" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="Application map status filter" />
                        <ComboBox Grid.Column="4" Height="42" Padding="10,6" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="Application sort order" />
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                <Button Style="{StaticResource ApplicationRowStyle}" Tag="{Binding}" Click="OpenApplication_Click"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        ContextMenu="{StaticResource ApplicationContextMenu}"
                                        ContextMenuOpening="ApplicationContextMenu_Opening">
                                    <Grid MinHeight="90">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="2.1*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="1.35*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" Background="{StaticResource AccentBrush}" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding ExecutableName}" FontSize="11.5" Foreground="{StaticResource MutedInkBrush}" />
                                                <TextBlock Text="  ·  " Foreground="{StaticResource MutedInkBrush}" />
                                                <TextBlock Text="{Binding VersionSummary}" FontSize="11.5" Foreground="{StaticResource MutedInkBrush}" />
                                                <TextBlock Text="  ·  " Foreground="{StaticResource MutedInkBrush}" />
                                                <TextBlock Text="{Binding RecordingSummary}" FontSize="11.5" Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center" Margin="12,0,24,0">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" FontSize="11.5" />
                                        </Border>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5" Margin="0,0,20,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="No Ready map" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReadyMap}" Value="True"><Setter Property="Text" Value="Ready map available" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding LatestActivity}" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Button>
                                <Button Width="32" Height="32" Padding="0" Margin="0,0,34,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0" Tag="{Binding}" ToolTip="More actions"
                                        AutomationProperties.Name="Application actions" Click="ApplicationMenu_Click"
                                        ContextMenu="{StaticResource ApplicationContextMenu}"
                                        ContextMenuOpening="ApplicationContextMenu_Opening">
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Grid.Row="3" Margin="0,16,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedInkBrush}" FontSize="12">
                            <Run Text="{Binding ApplicationCount, Mode=OneWay}"/><Run Text=" applications  ·  "/><Run Text="{Binding MapCount, Mode=OneWay}"/><Run Text=" recordings"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Status}" Margin="0,5,18,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource QuietButtonStyle}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/><TextBlock Text="Refresh"/></StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="ApplicationDetailsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="{StaticResource AccentBrush}" CornerRadius="9" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="32" FontWeight="Light" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="{Binding ExecutableName}" Foreground="{StaticResource MutedInkBrush}"/>
                            <TextBlock Text="  ·  " Foreground="{StaticResource MutedInkBrush}"/><TextBlock Text="{Binding VersionSummary}" Foreground="{StaticResource MutedInkBrush}"/>
                            <TextBlock Text="  ·  " Foreground="{StaticResource MutedInkBrush}"/><TextBlock Text="{Binding RecordingSummary}" Foreground="{StaticResource MutedInkBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ActiveDetailsActions" Grid.Column="2" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                        </StackPanel.Style>
                        <Button Content="Archive all drafts" MinWidth="154" Height="42" Margin="0,0,10,0"
                                Style="{StaticResource ArchiveActionButtonStyle}" Tag="{Binding}" IsEnabled="{Binding HasDrafts}"
                                Click="ArchiveAllDrafts_Click" />
                        <Button x:Name="RecordNewMapForApplicationButton" MinWidth="168" Height="42"
                                Style="{StaticResource PrimaryActionButtonStyle}" IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True" Click="RecordNewMapForApplication_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81E;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="Record new map"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <Button x:Name="RestoreApplicationButton" Grid.Column="2" Content="Restore application" MinWidth="168" Height="42"
                            Tag="{Binding}" Click="RestoreApplication_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Margin="0,28,0,0" Padding="16,13" CornerRadius="8" Background="#EDF6FF" BorderBrush="#BBD9F5" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#2477C9" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="One Ready UI Map per application version. Choosing another moves the current Ready map back to Draft." Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,24,0,0">
                    <RadioButton x:Name="DetailsActiveTab" GroupName="DetailsArchiveScope" Content="Active" IsChecked="True" Style="{StaticResource LibraryTabStyle}" Click="DetailsActiveTab_Click"/>
                    <RadioButton x:Name="DetailsArchiveTab" GroupName="DetailsArchiveScope" Content="Archive" Style="{StaticResource LibraryTabStyle}" Click="DetailsArchiveTab_Click"/>
                </StackPanel>

                <ItemsControl x:Name="VersionsItemsControl" Grid.Row="3" Margin="0,18,0,10" ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,18" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9">
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid MinHeight="60" Margin="16,0,9,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Heading}" FontSize="15.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding RecordingSummary}" Margin="14,0,0,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" Margin="20,0,12,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Maps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,14">
                                                    <Grid MinHeight="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Updated}"/>
                                                            <TextBlock Text="{Binding Reference}" Margin="0,4,12,0" Foreground="{StaticResource MutedInkBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                            <TextBlock Text="{Binding Counts}" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedInkBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center" Margin="8,0,18,0">
                                                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" FontSize="11.5"/>
                                                        </Border>
                                                        <Button Grid.Column="3" Content="Open" MinWidth="76" Style="{StaticResource QuietButtonStyle}" Tag="{Binding}" Click="OpenArtifact_Click"/>
                                                        <Button Grid.Column="4" Content="Mark ready" MinWidth="104" Margin="10,0,0,0" Tag="{Binding}" Click="MarkReady_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Grid.Column="4" Content="Mark as draft" MinWidth="104" Margin="10,0,0,0" Tag="{Binding}" Click="MarkDraft_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Grid.Column="5" Content="Archive" MinWidth="82" Margin="8,0,0,0" Tag="{Binding}" Click="Archive_Click">
                                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ArchiveActionButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                        </Button>
                                                        <Button Grid.Column="5" Content="Restore" MinWidth="82" Margin="8,0,0,0" Tag="{Binding}" Click="Restore_Click">
                                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsArchived}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="DetailsEmptyState" Grid.Row="3" Margin="0,34,0,0" Visibility="Collapsed"
                           Text="No UI Map recordings in this section." Foreground="{StaticResource MutedInkBrush}" FontSize="14"/>
            </Grid>
        </ScrollViewer>

        <Border x:Name="RecordingCompletePanel" Visibility="Collapsed" Background="#F4FFFFFF" Panel.ZIndex="20" Padding="36">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="62" Height="62" CornerRadius="31" BorderBrush="#159447" BorderThickness="2" HorizontalAlignment="Left"><TextBlock Text="✓" FontSize="34" Foreground="#159447" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="UI Map recording complete" FontSize="32" FontWeight="Light"/><TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedInkBrush}"><Run Text="{Binding DisplayName}"/><Run Text=" was recorded successfully. Review it, then choose Ready or Draft."/></TextBlock></StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,28,0,0">
                        <StackPanel><TextBlock Text="What MapLock found" FontSize="16" FontWeight="SemiBold"/><UniformGrid Columns="4" Margin="0,20,0,0">
                            <StackPanel><TextBlock Text="{Binding SurfaceCount}" FontSize="27" HorizontalAlignment="Center"/><TextBlock Text="surfaces" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding ControlCount}" FontSize="27" HorizontalAlignment="Center"/><TextBlock Text="controls" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding DataGridCount}" FontSize="27" HorizontalAlignment="Center"/><TextBlock Text="Data Grids" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding ObservationCount}" FontSize="27" HorizontalAlignment="Center"/><TextBlock Text="observations" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center"/></StackPanel>
                        </UniformGrid></StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="Mapped surfaces" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Surfaces}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource MutedInkBrush}"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#159447"/></Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Ready replaces the current Ready map for this version. Draft leaves it unchanged." Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="Archive" Click="RecordingArchive_Click" MinWidth="110" Height="42" Margin="10,0,0,0" Style="{StaticResource ArchiveActionButtonStyle}"/>
                        <Button Grid.Column="2" Content="Review" Click="RecordingReview_Click" MinWidth="110" Height="42" Margin="10,0,0,0" Style="{StaticResource RecorderSecondaryButtonStyle}"/>
                        <Button Grid.Column="3" Content="Draft" Click="RecordingDraft_Click" MinWidth="110" Height="42" Margin="10,0,0,0" Style="{StaticResource RecorderSecondaryButtonStyle}"/>
                        <Button Grid.Column="4" Content="Ready" Click="RecordingReady_Click" MinWidth="110" Height="42" Margin="10,0,0,0" Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
