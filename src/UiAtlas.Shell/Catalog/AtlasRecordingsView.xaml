<UserControl x:Class="UiAtlas.Shell.Catalog.AtlasRecordingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AutomationProperties.Name="UI Map recordings library">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Views/LibraryStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="Recordings" FontSize="38" FontWeight="Light" Foreground="{StaticResource InkBrush}"/>
    <TextBlock Text="UI Map recordings, organized by application." Margin="0,9,0,0" FontSize="15.5" Foreground="{StaticResource MutedInkBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
     <RadioButton x:Name="ActiveTab" GroupName="RecordingArchiveScope" Content="Active" IsChecked="True" Style="{StaticResource LibraryTabStyle}" Click="Scope_Click"/>
     <RadioButton x:Name="ArchiveTab" GroupName="RecordingArchiveScope" Content="Archive" Style="{StaticResource LibraryTabStyle}" Click="Scope_Click"/>
    </StackPanel>
   </StackPanel>
   <Grid Grid.Row="1" Margin="0,30,0,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Recordings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="CancelButton" Content="Cancel build" Visibility="Collapsed" Style="{StaticResource QuietButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/>
     <Button Content="Import…" Style="{StaticResource QuietButtonStyle}" Click="Import_Click" Margin="0,0,8,0"/>
     <Button Style="{StaticResource QuietButtonStyle}" Click="Refresh_Click" ToolTip="Refresh recordings" AutomationProperties.Name="Refresh recordings" Margin="0,0,8,0"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons"/></Button>
     <Button Style="{StaticResource QuietButtonStyle}" Click="Utilities_Click" ToolTip="More actions" AutomationProperties.Name="Recording library actions">
      <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons"/>
      <Button.ContextMenu><ContextMenu><MenuItem Header="Find previous MapLock recordings…" Click="FindLegacy_Click"/></ContextMenu></Button.ContextMenu>
     </Button>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
     <Grid>
      <TextBox x:Name="SearchBox" Height="42" Padding="39,10,12,8" TextChanged="Search_Changed" AutomationProperties.Name="Search recordings" ToolTip="Search by application, recording ID, or outcome"/>
      <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <TextBlock Text="Search recordings" Margin="39,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
     <ComboBox x:Name="ApplicationFilter" Grid.Column="2" Height="42" Padding="10,6" SelectionChanged="Filter_Changed" AutomationProperties.Name="Recording application filter"/>
     <ComboBox x:Name="StatusFilter" Grid.Column="4" Height="42" Padding="10,6" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Recording status filter"><ComboBoxItem Content="All statuses"/><ComboBoxItem Content="Map built"/><ComboBoxItem Content="Not built"/><ComboBoxItem Content="Invalid"/></ComboBox>
     <ComboBox x:Name="SortFilter" Grid.Column="6" Height="42" Padding="10,6" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Recording sort order"><ComboBoxItem Content="Recently recorded"/><ComboBoxItem Content="Oldest recorded"/><ComboBoxItem Content="Application A–Z"/></ComboBox>
    </Grid>
   </Grid>
   <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9">
    <StackPanel>
     <ItemsControl x:Name="RecordingList">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Grid ContextMenuOpening="Recording_ContextMenuOpening">
        <Grid.ContextMenu><ContextMenu/></Grid.ContextMenu>
        <Button Style="{StaticResource ApplicationRowStyle}" Tag="{Binding}" Click="OpenRecording_Click" ToolTip="{Binding Details}" AutomationProperties.Name="{Binding Title}">
         <Grid MinHeight="90">
          <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
          <Border Width="46" Height="46" Background="{StaticResource AccentBrush}" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Metadata}" FontSize="11.5" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center" Margin="12,0,24,0"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" FontSize="11.5"/></Border>
          <TextBlock Grid.Column="3" Text="{Binding Description}" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5" Margin="0,0,20,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="4" Text="{Binding RecordedAt}" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="5" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
         </Grid>
        </Button>
        <Button Width="32" Height="32" Padding="0" Margin="0,0,34,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Tag="{Binding}" ToolTip="More actions" AutomationProperties.Name="Recording actions" Click="RecordingMenu_Click"><TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="14"/></Button>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="EmptyMessage" Text="Loading recordings…" Margin="24,36" HorizontalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <StackPanel Grid.Row="3" Margin="0,16,0,6">
    <TextBlock x:Name="CountText" Foreground="{StaticResource MutedInkBrush}" FontSize="12"/>
    <TextBlock x:Name="StatusText" Margin="0,5,18,0" Foreground="{StaticResource MutedInkBrush}" FontSize="11.5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</UserControl>
