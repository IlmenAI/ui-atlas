<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ui-atlas</AssemblyName>
    <RootNamespace>UiAtlas.Core.Cli</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UiAtlas.Catalog.Contracts/UiAtlas.Catalog.Contracts.csproj" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="../UiAtlas.Core.Contracts/UiAtlas.Core.Contracts.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Mapping/UiAtlas.Core.Mapping.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Mapping.Atlas/UiAtlas.Core.Mapping.Atlas.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Recording/UiAtlas.Core.Recording.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Recording.Windows/UiAtlas.Core.Recording.Windows.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Build/UiAtlas.Core.Build.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Storage/UiAtlas.Core.Storage.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Reader/UiAtlas.Core.Reader.csproj" />
    <ProjectReference Include="../UiAtlas.Core.Desktop/UiAtlas.Core.Desktop.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets\recorder-reference.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\recorder-icon-*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\recorder-icon-*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\recorder-wave-art.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\recorder-popup-underlay.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="PublishDesktopExplorer" AfterTargets="Publish" Condition="'$(PublishDesktopExplorer)' != 'false'">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\UiAtlas.Core.Desktop\UiAtlas.Core.Desktop.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);PublishDir=$(PublishDir);PublishDesktopExplorer=false" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../../vendor/uimaps/uimaps-recorder/src/UIMaps.Recorder.ProviderProbe/UIMaps.Recorder.ProviderProbe.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="StageNativeRecorder" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../vendor/uimaps/uimaps-recorder/src/UIMaps.Recorder.ProviderProbe/UIMaps.Recorder.ProviderProbe.csproj" Targets="GetNativeRecorderDeploymentFiles" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_NativeRecorderFiles" />
    </MSBuild>
    <Copy SourceFiles="@(_NativeRecorderFiles)" DestinationFiles="@(_NativeRecorderFiles->'$(OutDir)native-recorder/%(NativeRecorderRelativePath)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishNativeRecorder" AfterTargets="Publish">
    <PropertyGroup>
      <_NativeRecorderUseAppHost>false</_NativeRecorderUseAppHost>
      <_NativeRecorderUseAppHost Condition="'$(SelfContained)' == 'true'">true</_NativeRecorderUseAppHost>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../vendor/uimaps/uimaps-recorder/src/UIMaps.Recorder.ProviderProbe/UIMaps.Recorder.ProviderProbe.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)native-recorder/;UseAppHost=$(_NativeRecorderUseAppHost)" />
  </Target>
  <Target Name="StageDesktopExplorer" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Ask the dependency for its actual output, including isolated build roots. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\UiAtlas.Core.Desktop\UiAtlas.Core.Desktop.csproj"
             Targets="GetDesktopExplorerDeploymentFiles"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DesktopExplorerDeploymentFiles" />
    </MSBuild>
    <Error Condition="'@(_DesktopExplorerDeploymentFiles)' == ''" Text="The map viewer was not built with the recorder." />
    <Copy SourceFiles="@(_DesktopExplorerDeploymentFiles)"
          DestinationFiles="@(_DesktopExplorerDeploymentFiles->'$(TargetDir)viewer\%(ExplorerRelativePath)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_DesktopExplorerDeploymentFiles->'$(TargetDir)viewer\%(ExplorerRelativePath)')" />
    </ItemGroup>
  </Target>
  <Target Name="GetAtlasDeploymentFiles" DependsOnTargets="Build" Returns="@(_AtlasDeploymentFiles)">
    <ItemGroup>
      <_AtlasDeploymentFiles Include="$(TargetDir)**/*" Exclude="$(TargetDir)**/*.pdb" />
      <_AtlasDeploymentFiles Update="@(_AtlasDeploymentFiles)" AtlasRelativePath="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
