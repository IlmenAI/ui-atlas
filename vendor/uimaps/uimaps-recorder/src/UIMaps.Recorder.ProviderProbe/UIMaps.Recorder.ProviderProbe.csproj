<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <UseWPF>true</UseWPF>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>UIMaps.Recorder.ProviderProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UIMaps.Recorder.Windows/UIMaps.Recorder.Windows.csproj" />
  </ItemGroup>
  <Target Name="GetNativeRecorderDeploymentFiles" DependsOnTargets="GetTargetPath" Returns="@(_NativeRecorderDeploymentFiles)">
    <ItemGroup>
      <_NativeRecorderDeploymentFiles Include="$(TargetDir)**/*" Exclude="$(TargetDir)**/*.pdb" />
      <_NativeRecorderDeploymentFiles Update="@(_NativeRecorderDeploymentFiles)">
        <NativeRecorderRelativePath>%(RecursiveDir)%(Filename)%(Extension)</NativeRecorderRelativePath>
      </_NativeRecorderDeploymentFiles>
    </ItemGroup>
  </Target>
</Project>
